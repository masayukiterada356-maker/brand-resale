{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brand-resale",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 画面でも使うプログラム（CSVの読み取りなど）を public/shared/ に写してから動かす
  "build": { "command": "node scripts/copy-shared.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brand-resale-db",
      // Cloudflareに載せる時に `npx wrangler d1 create brand-resale-db` で出てくるIDに差し替える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // サムネイルの保存場所（Workers KV。無料・カード登録不要）
  "kv_namespaces": [
    { "binding": "STORE", "id": "00000000000000000000000000000000" }
  ],
  "vars": {
    // 外注さんの共有フォルダ「寺田 将之さん」
    "DRIVE_ROOT_FOLDER_ID": "1351D_voeNntH7PIP3KGBtPPqQVd23s4y",
    // この日以降に作られた日付フォルダだけ取り込む（それより前の写真は今のやり方で出品済みのため）
    "PHOTO_SYNC_FROM": "2026-11-01"
  },
  // 1時間ごとにドライブを確認
  "triggers": { "crons": ["17 * * * *"] }
}
