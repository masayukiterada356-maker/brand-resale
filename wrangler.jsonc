{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brand-resale",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brand-resale-db",
      // Cloudflareに載せる時に `npx wrangler d1 create brand-resale-db` で出てくるIDに差し替える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
